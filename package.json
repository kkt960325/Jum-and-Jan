  "private": true,
  "scripts": {
    "predev": "npx tsx scripts/generate-images-manifest.ts",
    "dev": "next dev",
    "prebuild": "npx tsx scripts/generate-images-manifest.ts && python3 scripts/verify-images.py",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:images": "python3 scripts/verify-images.py",
    "audit": "python3 scripts/audit-report.py",
    "seed:supabase": "npx tsx scripts/seed-supabase.ts",
    "hunt:images": "npx tsx scripts/hunt-images.ts",
    "hunt:whiskybase": "npx tsx scripts/hunt-whiskybase.ts",
    "verify:images:vision": "npx tsx scripts/verify-images.ts",
    "verify:images:vision:priority": "npx tsx scripts/verify-images.ts -- --priority-only",
    "verify:images:vision:dry": "npx tsx scripts/verify-images.ts -- --dry-run"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@google/genai": "^1.52.0",
